{
  "name": "espressoduty",
  "version": "0.1.0",
  "private": true,
  "description": "Uptime monitoring and alerting for Espresso Network validators",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "postbuild": "cp -r .next/static .next/standalone/.next/static",
    "start": "node -r dotenv/config .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^0.454.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "nanoid": "^3.3.20",
    "source-map-js": "^1.2.2"
  }
}
